#!/bin/bash

set -euo pipefail

# $1 is column number (starting from 1)
# $2 is pattern to match

IFS=$'\t'

while read line; do
    array=(${line})
    column=${array[$(($1-1))]:-}
    if [[ $column =~ $2 ]]; then
        value=${BASH_REMATCH[1]:-}
        echo -e "$line\t$value"
    elif [[ $line == "" ]]; then
        echo -e "$line"
    fi    
done

