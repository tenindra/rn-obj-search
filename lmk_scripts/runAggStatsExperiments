        cat $max_varyingqvsetsubnetsize_stats_file_path | bash extractColumnAndAppend 4 "cand_spdist=([[:digit:]]+)" > $temp_file_path # Column 13 - False Hits
        cat $temp_file_path > $max_varyingqvsetsubnetsize_stats_file_path
        rm $temp_file_path
    fi

    if [ "$aknn_varyingk" == "1" ]; then
        temp_file_path="$stats_dir/temp_$sum_varyingk_stats_file"
        cat $sum_varyingk_stats_file_path | bash extractColumnAndAppend 4 "cand_spdist=([[:digit:]]+)" > $temp_file_path # Column 13 - False Hits
        cat $temp_file_path > $sum_varyingk_stats_file_path
        rm $temp_file_path
    fi
    if [ "$aknn_varyingdensity" == "1" ]; then
        temp_file_path="$stats_dir/temp_$sum_varyingdensity_stats_file"
        cat $sum_varyingdensity_stats_file_path | bash extractColumnAndAppend 4 "cand_spdist=([[:digit:]]+)" > $temp_file_path # Column 13 - False Hits
        cat $temp_file_path > $sum_varyingdensity_stats_file_path
        rm $temp_file_path
    fi
    if [ "$aknn_varyingqvsetsize" == "1" ]; then
        temp_file_path="$stats_dir/temp_$sum_varyingqvsetsize_stats_file"
        cat $sum_varyingqvsetsize_stats_file_path | bash extractColumnAndAppend 4 "cand_spdist=([[:digit:]]+)" > $temp_file_path # Column 13 - False Hits
        cat $temp_file_path > $sum_varyingqvsetsize_stats_file_path
        rm $temp_file_path
    fi
    if [ "$aknn_varyingqvsetsubnetsize" == "1" ]; then
        temp_file_path="$stats_dir/temp_$sum_varyingqvsetsubnetsize_stats_file"
        cat $sum_varyingqvsetsubnetsize_stats_file_path | bash extractColumnAndAppend 4 "cand_spdist=([[:digit:]]+)" > $temp_file_path # Column 13 - False Hits
        cat $temp_file_path > $sum_varyingqvsetsubnetsize_stats_file_path
        rm $temp_file_path
    fi

    # Create Separate Stats File without IER for Lower-Bound Computation Comparison
    if [ "$aknn_varyingk" == "1" ]; then
        cat $max_varyingk_stats_file_path | bash excludeStatsRows 5 ier_phl | bash excludeEmptyRows | bash splitStatsRows 5 | bash extractColumnAndAppend 4 "cand_unpruned=([[:digit:]]+)" > $lbs_max_varyingk_stats_file_path # Column 14 - Total Number of Lowerbounds Computed
    fi
    if [ "$aknn_varyingdensity" == "1" ]; then
        cat $max_varyingdensity_stats_file_path | bash excludeStatsRows 5 ier_phl | bash excludeEmptyRows | bash splitStatsRows 5 | bash extractColumnAndAppend 4 "cand_unpruned=([[:digit:]]+)" > $lbs_max_varyingdensity_stats_file_path # Column 14 - Total Number of Lowerbounds Computed
    fi
    if [ "$aknn_varyingqvsetsize" == "1" ]; then
        cat $max_varyingqvsetsize_stats_file_path | bash excludeStatsRows 5 ier_phl | bash excludeEmptyRows | bash splitStatsRows 5 | bash extractColumnAndAppend 4 "cand_unpruned=([[:digit:]]+)" > $lbs_max_varyingqvsetsize_stats_file_path # Column 17 - Total Number of Lowerbounds Computed
    fi
    if [ "$aknn_varyingqvsetsubnetsize" == "1" ]; then
        cat $max_varyingqvsetsubnetsize_stats_file_path | bash excludeStatsRows 5 ier_phl | bash excludeEmptyRows | bash splitStatsRows 5 | bash extractColumnAndAppend 4 "cand_unpruned=([[:digit:]]+)" > $lbs_max_varyingqvsetsubnetsize_stats_file_path # Column 17 - Total Number of Lowerbounds Computed
    fi
    if [ "$aknn_varyingk" == "1" ]; then
        cat $sum_varyingk_stats_file_path | bash excludeStatsRows 5 ier_phl | bash excludeEmptyRows | bash splitStatsRows 5 | bash extractColumnAndAppend 4 "cand_unpruned=([[:digit:]]+)" > $lbs_sum_varyingk_stats_file_path # Column 17 - Total Number of Lowerbounds Computed
    fi
    if [ "$aknn_varyingdensity" == "1" ]; then
        cat $sum_varyingdensity_stats_file_path | bash excludeStatsRows 5 ier_phl | bash excludeEmptyRows | bash splitStatsRows 5 | bash extractColumnAndAppend 4 "cand_unpruned=([[:digit:]]+)" > $lbs_sum_varyingdensity_stats_file_path # Column 17 - Total Number of Lowerbounds Computed
    fi
    if [ "$aknn_varyingqvsetsize" == "1" ]; then
        cat $sum_varyingqvsetsize_stats_file_path | bash excludeStatsRows 5 ier_phl | bash excludeEmptyRows | bash splitStatsRows 5 | bash extractColumnAndAppend 4 "cand_unpruned=([[:digit:]]+)" > $lbs_sum_varyingqvsetsize_stats_file_path # Column 17 - Total Number of Lowerbounds Computed
    fi
    if [ "$aknn_varyingqvsetsubnetsize" == "1" ]; then
        cat $sum_varyingqvsetsubnetsize_stats_file_path | bash excludeStatsRows 5 ier_phl | bash excludeEmptyRows | bash splitStatsRows 5 | bash extractColumnAndAppend 4 "cand_unpruned=([[:digit:]]+)" > $lbs_sum_varyingqvsetsubnetsize_stats_file_path # Column 17 - Total Number of Lowerbounds Computed
    fi
fi

# Generate Figures

# Max

# Varying K
if [ "$aknn_varyingk" == "1" ]; then
    varyingk_figure_file_prefix="cand_spdist_stats_${default_network}_$aknn_max_varyingk_stats_file_suffix"
    bash generateFigure $fig_dir/$varyingk_figure_file_prefix $max_varyingk_stats_file_path "6,# of Results (k),$aknn_kvalues_xtics,'','',''" "14,Network Distances,logscale,'10^%T'" "IER;dark-magenta;12,NVD;dark-green;6,COLT;dark-red;4" "right bottom,vertical maxrows 1,0"
    varyingk_figure_file_prefix="cand_unpruned_stats_${default_network}_$aknn_max_varyingk_stats_file_suffix"
    bash generateFigure $fig_dir/$varyingk_figure_file_prefix $lbs_max_varyingk_stats_file_path "6,# of Results (k),$aknn_kvalues_xtics,'','',''" "15,Candidates,logscale,'10^%T'" "NVD;dark-green;6,COLT;dark-red;4" "left top,vertical maxrows 2,0"
