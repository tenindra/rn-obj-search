    varyingk_figure_file_prefix="cand_unpruned_stats_${default_network}_$aknn_sum_varyingk_stats_file_suffix"
    bash generateFigure $fig_dir/$varyingk_figure_file_prefix $lbs_sum_varyingk_stats_file_path "6,# of Results (k),$aknn_kvalues_xtics,'','',''" "15,Candidates,logscale,'10^%T'" "NVD;dark-green;6,COLT;dark-red;4" "left center,vertical maxrows 2,0"
