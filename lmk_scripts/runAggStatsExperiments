sum_varyingqvsetsubnetsize_stats_file_path="$stats_dir/$sum_varyingqvsetsubnetsize_stats_file"
if [ "$aknn_varyingqvsetsubnetsize" == "1" ] && [ -f "$sum_varyingqvsetsubnetsize_stats_file_path" ] && [ "$figures_only" == false ]; then
    if [ "$overwrite" == false ]; then
        mv "$sum_varyingqvsetsubnetsize_stats_file_path" "$stats_dir/${sum_varyingqvsetsubnetsize_stats_file}_$(date +%Y-%m-%d-%H:%M:%S).txt"
    else
        rm "$sum_varyingqvsetsubnetsize_stats_file_path"
    fi
fi

aknn_rw="0" # Don't run real-world experiments for stats collection
aknn_query_parameters="$aknn_methods,aknn_def_k=$aknn_def_k,aknn_def_density=$aknn_def_density,aknn_def_type=$aknn_def_type,aknn_def_var=$aknn_def_var,\
aknn_rw=$aknn_rw,aknn_qv_def_setsize=$aknn_qv_def_setsize,aknn_qv_max_setsize=$aknn_qv_max_setsize,aknn_num_qv_sets=$aknn_num_qv_sets,\
aknn_qv_def_setsubnetsize=$aknn_qv_def_setsubnetsize,aknn_varyingk=$aknn_varyingk,aknn_varyingdensity=$aknn_varyingdensity,aknn_varyingqvsetsize=$aknn_varyingqvsetsize,aknn_varyingqvsetsubnetsize=$aknn_varyingqvsetsubnetsize"

index_parameters="aknn_index_parameters"
obj_index_parameters="aknn_obj_index_parameters" # Part of the object index file names
query_parameters="$dataset_index_parameters,${!index_parameters},${!obj_index_parameters},$aknn_query_parameters,\
max_aknn_varyingk_stats_file=$max_varyingk_stats_file,sum_aknn_varyingk_stats_file=$sum_varyingk_stats_file,\
max_aknn_varyingdensity_stats_file=$max_varyingdensity_stats_file,sum_aknn_varyingdensity_stats_file=$sum_varyingdensity_stats_file,\
max_aknn_varyingrwset_stats_file=$max_varyingrwset_stats_file,sum_aknn_varyingrwset_stats_file=$sum_varyingrwset_stats_file,\
max_aknn_varyingqvsetsize_stats_file=$max_varyingqvsetsize_stats_file,sum_aknn_varyingqvsetsize_stats_file=$sum_varyingqvsetsize_stats_file,\
max_aknn_varyingqvsetsubnetsize_stats_file=$max_varyingqvsetsubnetsize_stats_file,sum_aknn_varyingqvsetsubnetsize_stats_file=$sum_varyingqvsetsubnetsize_stats_file"


# Note: No '=' signs allowed in stats file names

# Need to create a new file for LBs computed results because we have to remove IER results
# as we are comparing LLBs for OL vs NVD approaches
lbs_max_varyingk_stats_file_path="$stats_dir/lbs_$max_varyingk_stats_file"
lbs_max_varyingdensity_stats_file_path="$stats_dir/lbs_$max_varyingdensity_stats_file"
lbs_max_varyingqvsetsize_stats_file_path="$stats_dir/lbs_$max_varyingqvsetsize_stats_file"
lbs_max_varyingqvsetsubnetsize_stats_file_path="$stats_dir/lbs_$max_varyingqvsetsubnetsize_stats_file"
lbs_sum_varyingk_stats_file_path="$stats_dir/lbs_$sum_varyingk_stats_file"
lbs_sum_varyingdensity_stats_file_path="$stats_dir/lbs_$sum_varyingdensity_stats_file"
lbs_sum_varyingqvsetsize_stats_file_path="$stats_dir/lbs_$sum_varyingqvsetsize_stats_file"
lbs_sum_varyingqvsetsubnetsize_stats_file_path="$stats_dir/lbs_$sum_varyingqvsetsubnetsize_stats_file"

# Run Experiments
if [ "$figures_only" == false ]; then
    args="-c lmk_agg_exp -e query_exp -g $idx_dir/$default_network.bin
    -k $aknn_kvalues -n $aknn_num_sets -d $aknn_densities -t $aknn_def_type -v $aknn_def_var -p $query_parameters ${rw_sets:+-r $rw_sets} 
    -m $aknn_qv_setsizes -y $aknn_qv_setsubnetsizes -f $output_path"

    # echo "${exe_path}/$main_program_stats $args"
    ${exe_path}/$main_program_stats $args

    # Fix stats files for future figure generation
    if [ "$aknn_varyingk" == "1" ]; then
        temp_file_path="$stats_dir/temp_$max_varyingk_stats_file"
        cat $max_varyingk_stats_file_path | bash extractColumnAndAppend 4 "cand_spdist=([[:digit:]]+)" > $temp_file_path # Column 13 - False Hits
        cat $temp_file_path > $max_varyingk_stats_file_path
        rm $temp_file_path
    fi
    if [ "$aknn_varyingdensity" == "1" ]; then
        temp_file_path="$stats_dir/temp_$max_varyingdensity_stats_file"
        cat $max_varyingdensity_stats_file_path | bash extractColumnAndAppend 4 "cand_spdist=([[:digit:]]+)" > $temp_file_path # Column 13 - False Hits
        cat $temp_file_path > $max_varyingdensity_stats_file_path
        rm $temp_file_path
    fi
