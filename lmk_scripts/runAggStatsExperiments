    bash generateFigure $fig_dir/$varyingdensity_figure_file_prefix $lbs_sum_varyingdensity_stats_file_path "9,Density,$aknn_densities_xtics,'',logscale,''" "15,Candidates,logscale,'10^%T'" "NVD;dark-green;6,COLT;dark-red;4" "left top,vertical maxrows 2,0"
