    varyingqvsetsize_figure_file_prefix="cand_unpruned_stats_${default_network}_$aknn_max_varyingqvsetsize_stats_file_suffix"
    bash generateFigure $fig_dir/$varyingqvsetsize_figure_file_prefix $lbs_max_varyingqvsetsize_stats_file_path "0,# of Query Vertices,usecol,10,'',''" "15,Candidates,logscale,'10^%T'" "NVD;dark-green;6,COLT;dark-red;4" "left top,vertical maxrows 2,0"
