if [ "$aknn_varyingqvsetsize" == "1" ]; then
    varyingqvsetsize_figure_file_prefix="cand_spdist_stats_${default_network}_$aknn_sum_varyingqvsetsize_stats_file_suffix"
    bash generateFigure $fig_dir/$varyingqvsetsize_figure_file_prefix $sum_varyingqvsetsize_stats_file_path "0,# of Query Vertices,usecol,10,'',''" "14,Network Distances,logscale,'10^%T'" "IER;dark-magenta;12,NVD;dark-green;6,COLT;dark-red;4" "right top,vertical maxrows 1,0"
